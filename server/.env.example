#
# Copy this file to `.env` and fill in your real key. NEVER commit `.env`.
# The API key stays on the SERVER ONLY — it is never sent to the browser or the repo.

# Your Anthropic API key (get one at https://console.anthropic.com/). Keep it secret.
ANTHROPIC_API_KEY=sk-ant-...replace-with-your-real-key...

# Optional overrides:
# Model id — cost-first default: claude-haiku-4-5 (raise to claude-sonnet-5 / claude-opus-5 for higher quality)
AI_MODEL=claude-haiku-4-5
# Effort for non-Haiku models only (Haiku 4.5 ignores it): low | medium | high (default: low)
AI_EFFORT=low
# Output cap per request in tokens (default: 700)
AI_MAX_TOKENS=700
# Cost guardrails
AI_RATE_LIMIT_PER_MIN=20         # requests per IP per minute (default: 20)
AI_MONTHLY_TOKEN_CAP=2000000     # monthly token budget; over cap -> HTTP 429 {fallback:true} (default: 2,000,000)
# Port the proxy listens on (default: 8787)
PORT=8787
# Allowed CORS origin for the browser app (default: * for local demo; restrict in production)
CORS_ORIGIN=*
